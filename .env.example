# =====================================================================
# ALEZZ GENERAL CONTRACTING - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your valid credentials
# =====================================================================

# 1. Supabase Public Anonymous API Credentials (Client-side safe)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-public-key

# 2. Application Environment Settings
VITE_APP_NAME="نظام الفوترة الإلكترونية - العز للمقاولات"
VITE_APP_ENV=production

# =====================================================================
# SECURITY NOTICE:
# DO NOT include SUPABASE_SERVICE_ROLE_KEY or ZATCA Private Keys in this file.
# Service Role keys and ZATCA production CSID private secrets must be configured
# exclusively inside Supabase Dashboard > Project Settings > Edge Functions Secrets.
# =====================================================================
